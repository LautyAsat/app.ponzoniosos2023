<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context="edu.unlpam.vet.ponzonosos.PreventionMeasuresActivity"
    android:orientation="vertical">

    <include layout="@layout/app_bar"/>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="15dp"
            android:orientation="vertical">

            <TextView
                android:layout_marginTop="15dp"
                android:layout_marginLeft="10dp"
                android:layout_marginRight="10dp"
                android:layout_marginEnd="10dp"
                android:layout_marginStart="10dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Medidas de Prevención"
                android:textStyle="bold"
                android:textSize="16sp" />

            <ImageView
                android:id="@+id/main_image"
                android:layout_marginTop="15dp"
                android:layout_marginBottom="10dp"
                android:layout_width="match_parent"
                android:layout_height="150dp"
                android:scaleType="centerCrop"
                android:src="@drawable/ic_launcher_background"/>

            <LinearLayout
                android:layout_marginTop="5dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingLeft="20dp"
                android:paddingStart="20dp"
                android:paddingRight="20dp"
                android:paddingEnd="20dp">

                <TextView
                    android:layout_marginTop="5dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/medida_prevencion_texto_1"
                    android:drawableLeft="@drawable/ic_check_item_list_green"
                    android:drawableStart="@drawable/ic_check_item_list_green"/>

                <TextView
                    android:layout_marginTop="5dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/medida_prevencion_texto_2"
                    android:drawableLeft="@drawable/ic_check_item_list_green"
                    android:drawableStart="@drawable/ic_check_item_list_green"/>

                <TextView
                    android:layout_marginTop="5dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/medida_prevencion_texto_3"
                    android:drawableLeft="@drawable/ic_check_item_list_green"
                    android:drawableStart="@drawable/ic_check_item_list_green"/>

                <TextView
                    android:layout_marginTop="5dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/medida_prevencion_texto_4"
                    android:drawableLeft="@drawable/ic_check_item_list_green"
                    android:drawableStart="@drawable/ic_check_item_list_green"/>

                <TextView
                    android:layout_marginTop="5dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/medida_prevencion_texto_5"
                    android:drawableLeft="@drawable/ic_check_item_list_green"
                    android:drawableStart="@drawable/ic_check_item_list_green"/>

                <TextView
                    android:layout_marginTop="5dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/medida_prevencion_texto_6"
                    android:drawableLeft="@drawable/ic_check_item_list_green"
                    android:drawableStart="@drawable/ic_check_item_list_green"/>

                <TextView
                    android:layout_marginTop="5dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/medida_prevencion_texto_7"
                    android:drawableLeft="@drawable/ic_check_item_list_green"
                    android:drawableStart="@drawable/ic_check_item_list_green"/>

            </LinearLayout>

            <LinearLayout
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginRight="40dp"
                android:layout_marginEnd="40dp"
                android:layout_marginLeft="40dp"
                android:layout_marginStart="40dp"
                android:layout_marginTop="20dp"
                android:baselineAligned="false">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/datos_facultad"
                    android:textSize="13sp"
                    android:gravity="center"/>

                <TextView
                    android:layout_marginTop="20dp"
                    android:layout_marginBottom="15dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/datos_asistencia"
                    android:textSize="13sp"
                    android:gravity="center"/>

            </LinearLayout>

        </LinearLayout>

    </ScrollView>



</LinearLayout>