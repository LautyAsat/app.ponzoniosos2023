<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    package="edu.unlpam.vet.ponzonosos">

    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="true"
        android:fullBackupContent="true"
        android:icon="@drawable/logoapp"
        android:label="@string/app_name"
        android:roundIcon="@drawable/logoapp"
        android:supportsRtl="true"
        android:theme="@style/CustomToolbarStyle"
        android:networkSecurityConfig="@xml/network_security_config"
        tools:ignore="GoogleAppIndexingWarning"
        tools:targetApi="n">
        <activity android:name="edu.unlpam.vet.ponzonosos.ContactUsActivity"/>
        <activity android:name="edu.unlpam.vet.ponzonosos.PreventionMeasuresActivity" />
        <activity android:name="edu.unlpam.vet.ponzonosos.WhatToDoActivity" />
        <activity android:name="edu.unlpam.vet.ponzonosos.AboutActivity" />
        <activity android:name="edu.unlpam.vet.ponzonosos.MostrarCatalogo" />
        <activity android:name="edu.unlpam.vet.ponzonosos.InfoAnimal" />
        <activity android:name="edu.unlpam.vet.ponzonosos.Galeria" />
        <activity android:name="edu.unlpam.vet.ponzonosos.SpacePhotoActivity" />
        <activity android:name="edu.unlpam.vet.ponzonosos.CatalogoGrid" />
        <activity android:name=".FullscreenGalleryActivity"
            android:exported="false"/>

        <activity android:name="edu.unlpam.vet.ponzonosos.MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>