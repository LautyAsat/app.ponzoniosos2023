<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    package="edu.unlpam.vet.ponzonosos">

    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="true"
        android:fullBackupContent="true"
        android:icon="@drawable/logoapp"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@drawable/logoapp"
        android:supportsRtl="true"
        android:theme="@style/CustomToolbarStyle"
        tools:ignore="GoogleAppIndexingWarning"
        >
        <activity
            android:name=".MostrarCatalogoPruebaActivity"
            android:exported="false" />
        <activity android:name=".ContactUsActivity" />
        <activity android:name=".PreventionMeasuresActivity" />
        <activity android:name=".WhatToDoActivity" />
        <activity android:name=".AboutActivity" />
        <activity android:name=".InfoAnimal" />
        <activity android:name=".Galeria" />
        <activity android:name=".SpacePhotoActivity" />

        <activity
            android:name=".FullscreenGalleryActivity"
            android:exported="false" />
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>