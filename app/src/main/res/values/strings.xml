    <string name="medida_prevencion_texto_1">Usar botas de caña alta, o polainas de cuero en salidas al campo.</string>
    <string name="medida_prevencion_texto_2">Ir observando el terreno.</string>
    <string name="medida_prevencion_texto_3">Tener cuidado al levantar objetos, al saltar troncos o piedras.</string>
    <string name="medida_prevencion_texto_4">Adecuada distribución de la basura y pasto corto.</string>
    <string name="medida_prevencion_texto_5">Protecciones en las aberturas de las casas.</string>
    <string name="medida_prevencion_texto_6">Tener presente dirección y teléfono del centro con antivenenos más cercano</string>
    <string name="medida_prevencion_texto_7">Tener presente dirección y teléfono del centro de información, asesoramiento y asistencia toxicológica.</string>
