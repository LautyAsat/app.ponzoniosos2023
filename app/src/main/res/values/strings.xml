<resources>
    <string name="app_name">Ponzoñosos de La Pampa</string>
    <string name="medidas_generales_texto_1">Retirar anillos, pulseras, cadenas, y todo aquel elemento que comprometa la circulación.</string>
    <string name="medidas_generales_texto_2">Inmovilizar y elevar miembro afectado.</string>
    <string name="medidas_generales_texto_3">Vigilar la mecánica respiratoria. </string>
    <string name="medidas_generales_texto_4">Evitar todo tipo de fármacos, ya que los mismos favorecen a las hemorragias. </string>
    <string name="medidas_generales_texto_5">Limpiar con agua el área afectada.</string>
    <string name="medidas_generales_texto_6">Colocar Compresas frías en la zona afectada.</string>
    <string name="medidas_generales_texto_7">Hidratar al accidentado.</string>
    <string name="medidas_generales_texto_8">Tranquilizar a la persona y mantener la calma.</string>
    <string name="medidas_generales_texto_9">Fotografiar, en lo posible, al ejemplar que produjo el accidente.</string>
    <string name="medidas_generales_texto_10">Concurrir al centro de salud más cercano.</string>
    <string name="que_no_debemos_hacer_texto_1">No usar torniquetes.</string>
    <string name="que_no_debemos_hacer_texto_2">No inyectar antiveneno en el sitio de la mordedura.</string>
    <string name="que_no_debemos_hacer_texto_3">No suministrar bebidas alcohólicas como estimulantes o para mitigar dolor.</string>
    <string name="que_no_debemos_hacer_texto_4">No realizar cortes en la herida ni succionar veneno.</string>
    <string name="que_no_debemos_hacer_texto_5">No colocar alcohol o vinagre en la zona afectada</string>
