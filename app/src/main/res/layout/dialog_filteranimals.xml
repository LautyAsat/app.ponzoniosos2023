<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="-13dp"
    android:paddingBottom="20dp"
    android:layout_marginHorizontal="16dp"
    android:clipChildren="false"
    android:clipToPadding="false"
    >


    <View
        android:id="@+id/corner"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:layout_marginEnd="20dp"
        android:background="@drawable/triangle"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <androidx.cardview.widget.CardView
        android:id="@+id/cvPopup"
        android:layout_marginHorizontal="6dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardCornerRadius="8dp"
        app:cardElevation="6dp"
        app:layout_constraintTop_toBottomOf="@+id/corner"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        >

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">


            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/peligrosidad"
                android:textSize="20sp"
                android:textStyle="bold"
                />


            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="16dp"
                android:weightSum="3">

                <androidx.cardview.widget.CardView
                    android:layout_width="100dp"
                    android:layout_height="match_parent"
                    android:layout_marginEnd="8dp"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="4dp">

                    <ImageButton
                        android:id="@+id/btn_peligrosidad_alta"
                        android:layout_width="match_parent"
                        android:layout_height="25dp"
                        android:contentDescription="@string/alta"
                        android:scaleType="centerCrop"
                        android:background="@drawable/red_texture" />
                </androidx.cardview.widget.CardView>


                <androidx.cardview.widget.CardView
                    android:layout_width="100dp"
                    android:layout_height="match_parent"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="4dp">

                    <ImageButton
                        android:id="@+id/btn_peligrosidad_media"
                        android:layout_width="match_parent"
                        android:layout_height="25dp"
                        android:contentDescription="@string/media"
                        android:scaleType="centerCrop"
                        android:background="@drawable/yellow_texture" />
                </androidx.cardview.widget.CardView>

                <androidx.cardview.widget.CardView
                    android:layout_width="100dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="8dp"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="4dp">

                    <ImageButton
                        android:id="@+id/btn_peligrosidad_baja"
                        android:layout_width="match_parent"
                        android:layout_height="25dp"
                        android:contentDescription="@string/baja"
                        android:scaleType="centerCrop"
                        android:background="@drawable/green_texture" />
                </androidx.cardview.widget.CardView>

            </LinearLayout>


            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/tamaño"
                android:textSize="20sp"
                android:textStyle="bold"
                />


            <LinearLayout
                style="?android:attr/buttonBarStyle"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="16dp"
                android:gravity="center"
                android:orientation="horizontal"
                android:weightSum="3">


                <Button
                    style="?android:attr/buttonBarButtonStyle"
                    android:id="@+id/btn_grande"
                    android:layout_width="0dp"
                    android:layout_height="36dp"
                    android:layout_marginStart="4dp"
                    android:layout_marginEnd="4dp"
                    android:layout_weight="1"
                    android:background="@drawable/gridborder"
                    android:textColor="#000000"
                    android:text="@string/grande"
                    android:textSize="16sp"/>

                <Button
                    style="?android:attr/buttonBarButtonStyle"
                    android:id="@+id/btn_mediano"
                    android:layout_width="0dp"
                    android:layout_height="36dp"
                    android:layout_marginStart="4dp"
                    android:layout_marginEnd="4dp"
                    android:layout_weight="1"
                    android:background="@drawable/gridborder"
                    android:textColor="#000000"
                    android:text="@string/mediano"
                    android:textSize="16sp"/>

                <Button
                    style="?android:attr/buttonBarButtonStyle"
                    android:id="@+id/btn_pequeno"
                    android:layout_width="0dp"
                    android:layout_height="36dp"
                    android:layout_marginStart="4dp"
                    android:layout_marginEnd="4dp"
                    android:layout_weight="1"
                    android:background="@drawable/gridborder"
                    android:textColor="#000000"
                    android:text="@string/peque_o"
                    android:textSize="16sp"/>

            </LinearLayout>


            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="8dp"
                >
                <Button
                    android:id="@+id/apply_filter"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:background="@drawable/blue_texture"
                    android:text="@string/aplicar"
                    android:fontFamily="@font/font_text"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="@android:color/white"/>
            </androidx.cardview.widget.CardView>


            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="8dp"
                android:layout_marginTop="10dp"
                >
                <Button
                    android:id="@+id/cancel_filter"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:background="@drawable/blue_texture"
                    android:text="@string/cancelar"
                    android:fontFamily="@font/font_text"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="@android:color/white"/>
            </androidx.cardview.widget.CardView>
        </LinearLayout>
    </androidx.cardview.widget.CardView>

</androidx.constraintlayout.widget.ConstraintLayout>

