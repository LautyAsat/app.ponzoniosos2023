<?xml version="1.0" encoding="utf-8"?>

    <LinearLayout
        xmlns:android="http://schemas.android.com/apk/res/android"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <include
            android:id="@+id/app_bar"
            layout="@layout/app_bar" />

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/fondo_tarjeta"
                    android:padding="0dp"
                    android:elevation="6dp"
                    android:layout_margin="16dp">


                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:background="@drawable/banner"
                        android:elevation="4dp"
                        android:gravity="center"
                        android:text="@string/ponzo_osos_de_la_pampa"
                        android:textColor="@android:color/white"
                        android:textSize="24sp"
                        android:textStyle="bold"
                        android:fontFamily="@font/poppins_bold"/>

                    <ImageView
                        android:id="@+id/app_logo"
                        android:layout_marginTop="20dp"
                        android:layout_width="200dp"
                        android:layout_height="wrap_content"
                        android:adjustViewBounds="true"
                        android:contentDescription="@string/background"
                        android:src = "@drawable/logoapp"
                        android:layout_gravity="center_horizontal"
                        />

                    <TextView
                        android:layout_marginTop="20dp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginRight="20dp"
                        android:layout_marginLeft="20dp"
                        android:text="@string/esta_aplicaci_n_es_parte_del_proyecto_reconocimiento_y_prevenci_n_de_accidentes_por_animales_ponzo_osos_en_la_regi_n_norte_de_la_provincia_de_la_pampa"
                        android:gravity="center_horizontal"
                        android:fontFamily="@font/font_text"/>

                    <TextView
                        android:id="@+id/web_link"
                        android:layout_marginTop="5dp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:autoLink="web"
                        android:text="@string/resoluci_n_n_316_2017_del_consejo_directivo"
                        android:gravity="center_horizontal"
                        android:layout_marginLeft="40dp"
                        android:layout_marginRight="40dp"
                        android:textSize="12sp"
                        android:layout_marginBottom="10dp"
                        android:textColor="@color/web_link"
                        android:fontFamily="@font/font_text"
                        />

                    <TextView
                        android:layout_marginTop="5dp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/las_fotograf_as_incluidas_en_la_aplicaci_n_forman_parte_de_registros_propios_de_los_integrantes_del_proyecto_y_de_consultas_enviadas_por_la_comunidad"
                        android:gravity="center_horizontal"
                        android:layout_marginLeft="40dp"
                        android:layout_marginRight="40dp"
                        android:textSize="12sp"
                        android:layout_marginBottom="10dp"
                        android:fontFamily="@font/font_text"/>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/colorPrimary"
                        android:layout_marginLeft="40dp"
                        android:layout_marginStart="40dp"
                        android:layout_marginRight="40dp"
                        android:layout_marginEnd="40dp"
                        android:layout_marginBottom="10dp"
                        android:layout_marginTop="10dp"/>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/a_o_de_inicio_y_finalizaci_n_del_proyecto"
                        android:gravity="center_horizontal"
                        android:layout_marginLeft="40dp"
                        android:layout_marginRight="40dp"
                        android:textSize="12sp"
                        android:fontFamily="@font/font_text"/>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/octubre_2017_a_octubre_2019"
                        android:gravity="center_horizontal"
                        android:layout_marginLeft="40dp"
                        android:layout_marginRight="40dp"
                        android:textSize="12sp"
                        android:layout_marginBottom="10dp"
                        android:fontFamily="@font/font_text"/>


                    <ImageView
                        android:id="@+id/vet_logo"
                        android:layout_marginTop="20dp"
                        android:layout_width="120dp"
                        android:layout_height="wrap_content"
                        android:adjustViewBounds="true"
                        android:contentDescription="@string/background"
                        android:src="@drawable/ic_launcher_background"
                        android:layout_gravity="center_horizontal"
                        android:layout_marginBottom="10dp"/>

                </LinearLayout>
        </ScrollView>
    </LinearLayout>