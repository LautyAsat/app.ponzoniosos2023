<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context="edu.unlpam.vet.ponzonosos.PreventionMeasuresActivity"
    android:orientation="vertical">

    <include layout="@layout/app_bar" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="344dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="15dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_marginLeft="10dp"
                android:layout_marginTop="15dp"
                android:layout_marginEnd="10dp"
                android:layout_marginRight="10dp"
                android:text="Medidas de Prevención"
                android:textSize="16sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:orientation="vertical"
                android:paddingStart="20dp"
                android:paddingLeft="20dp"
                android:paddingEnd="20dp"
                android:paddingRight="20dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:text="@string/medida_prevencion_texto_1"
                    app:drawableLeftCompat="@drawable/ic_check_item_list_green"
                    app:drawableStartCompat="@drawable/ic_check_item_list_green" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:text="@string/medida_prevencion_texto_2"
                    app:drawableLeftCompat="@drawable/ic_check_item_list_green"
                    app:drawableStartCompat="@drawable/ic_check_item_list_green" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:text="@string/medida_prevencion_texto_3"
                    app:drawableLeftCompat="@drawable/ic_check_item_list_green"
                    app:drawableStartCompat="@drawable/ic_check_item_list_green" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:text="@string/medida_prevencion_texto_4"
                    app:drawableLeftCompat="@drawable/ic_check_item_list_green"
                    app:drawableStartCompat="@drawable/ic_check_item_list_green" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:text="@string/medida_prevencion_texto_5"
                    app:drawableLeftCompat="@drawable/ic_check_item_list_green"
                    app:drawableStartCompat="@drawable/ic_check_item_list_green" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:text="@string/medida_prevencion_texto_6"
                    app:drawableLeftCompat="@drawable/ic_check_item_list_green"
                    app:drawableStartCompat="@drawable/ic_check_item_list_green" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:text="@string/medida_prevencion_texto_7"
                    app:drawableLeftCompat="@drawable/ic_check_item_list_green"
                    app:drawableStartCompat="@drawable/ic_check_item_list_green" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="40dp"
                android:layout_marginLeft="40dp"
                android:layout_marginTop="20dp"
                android:layout_marginEnd="40dp"
                android:layout_marginRight="40dp"
                android:baselineAligned="false"
                android:orientation="vertical">

            </LinearLayout>

        </LinearLayout>

    </ScrollView>



</LinearLayout>